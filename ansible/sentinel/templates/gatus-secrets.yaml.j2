---
# Rendered by Ansible from 1Password. Never committed - the checked-in file is
# the template, the rendered copy lives only at /opt/gatus/secrets.yaml on the
# VPS with mode 0400.
alerting:
  pushover:
    application-token: "{{ gatus_pushover_token }}"
    user-key: "{{ gatus_pushover_user_key }}"
    default-alert:
      description: health-check failed
      failure-threshold: 3
      success-threshold: 2
      send-on-resolved: true

# The cluster's Alertmanager pushes its Watchdog alert here. If the cluster dies
# the heartbeat stops, and this Gatus - which is NOT in the cluster - is what
# notices. That is the whole reason this box runs a second Gatus.
external-endpoints:
  - name: home-ops
    group: heartbeat
    token: "{{ gatus_heartbeat_token }}"
    heartbeat:
      interval: 10m
    alerts:
      - type: pushover
