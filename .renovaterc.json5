{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // NOTE: we intentionally do NOT extend the aggregate "github>home-operations/renovate-config"
  // (default.json), because it bundles :helmPostUpgradeTasks (helm-docs/helm-schema) which is for
  // chart-authoring repos and fails here with an allowedCommands artifact error. This repo consumes
  // charts, so we cherry-pick the sub-presets instead.
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    "github>home-operations/renovate-config:annotated.json5",
    "github>home-operations/renovate-config:groups.json5",
    "github>home-operations/renovate-config:labels.json5",
    "github>home-operations/renovate-config:semanticCommits.json5",
    "github>home-operations/renovate-config:sharedActions.json5",
    "local>gtw2/home-ops//.renovate/autoMerge.json5",
    "local>gtw2/home-ops//.renovate/groups.json5",
    "local>gtw2/home-ops//.renovate/grafanDashboards.json5",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  // No schedule: updates open as they are released, rather than all at once on
  // the weekend. Every PR is reviewed by kritika on the local model, which has
  // one slot, so a weekend batch queued its reviews for hours. Instead cap new
  // PRs per hour so reviews keep pace; leave concurrent PRs unlimited so open
  // ones never hold back new updates.
  prHourlyLimit: 2,
  prConcurrentLimit: 0,
  ignorePaths: ["**/*.sops.*"],
  // The shared presets do not set framework manager file patterns, and Renovate's
  // defaults do not match this repo's kubernetes/** layout — keep these explicit or
  // most HelmRelease/image/kustomize dependencies stop being detected.
  flux: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: ["/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/^kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
  customManagers: [
    {
      // CNPG Clusters use `imageName:`, which the kubernetes manager does not match.
      customType: "regex",
      description: "Process CloudNativePG Cluster images",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "imageName: (?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      // A major bump triggers an offline pg_upgrade and needs a new barman serverName,
      // so major upgrades are done by hand.
      description: "Disable Postgres major updates for CNPG Clusters",
      matchPackageNames: [
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/tensorchord/cloudnative-vectorchord",
      ],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
}
