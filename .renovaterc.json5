{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigestsToSemver',
    'abandonments:recommended',
    ':automergePr',
    ':configMigration',
    ':dependencyDashboard',
    'local>gtw2/home-ops//.renovate/home-operations/annotated.json5',
    'local>gtw2/home-ops//.renovate/home-operations/groups.json5',
    'local>gtw2/home-ops//.renovate/home-operations/labels.json5',
    'local>gtw2/home-ops//.renovate/home-operations/semanticCommits.json5',
    'local>gtw2/home-ops//.renovate/home-operations/sharedActions.json5',
    'local>gtw2/home-ops//.renovate/autoMerge.json5',
    'local>gtw2/home-ops//.renovate/groups.json5',
    'local>gtw2/home-ops//.renovate/grafanDashboards.json5',
    'local>gtw2/home-ops//.renovate/grafanaPlugins.json5',
  ],
  dependencyDashboard: {
    title: 'Renovate Dashboard 🤖',
  },
  prHourlyLimit: 6,
  prConcurrentLimit: 0,
  ignorePaths: [
    '**/*.sops.*',
  ],
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  helmfile: {
    managerFilePatterns: [
      '/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/^kustomization\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Process CloudNativePG Cluster images',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'imageName: (?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Process the FluxInstance distribution artifact',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'artifact: oci://(?<depName>ghcr\\.io/controlplaneio-fluxcd/flux-operator-manifests):(?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Process annotated remote resource URLs',
      managerFilePatterns: [
        '/(^|/)kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*-\\s+https://\\S+?/(?<currentValue>v?\\d+\\.\\d+\\.\\d+[^/\\s]*)/',
      ],
    },
  ],
  packageRules: [
    {
      description: 'Disable Postgres major updates for CNPG Clusters',
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/postgresql',
        'ghcr.io/tensorchord/cloudnative-vectorchord',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
  ],
}
